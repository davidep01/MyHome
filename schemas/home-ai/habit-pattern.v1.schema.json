{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pattern_id",
    "revision",
    "scope",
    "state",
    "context_rule_id",
    "steps",
    "period",
    "counts",
    "confidence",
    "wilson_lower",
    "coverage",
    "weighted_score",
    "baseline_frequency",
    "temporal_validation",
    "evidence_episode_ids",
    "algorithm",
    "reviewed_at",
    "expires_at",
    "privacy_scope_version",
    "status_reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pattern_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "subject_id"
          ],
          "properties": {
            "kind": {
              "const": "household"
            },
            "subject_id": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "subject_id"
          ],
          "properties": {
            "kind": {
              "const": "person"
            },
            "subject_id": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "subject_id"
          ],
          "properties": {
            "kind": {
              "const": "anonymous"
            },
            "subject_id": {
              "type": "null"
            }
          }
        }
      ]
    },
    "state": {
      "enum": [
        "candidate",
        "supported",
        "accepted",
        "suppressed",
        "retired"
      ]
    },
    "context_rule_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "capability_key",
          "target_entity_ids",
          "desired",
          "after_step_id",
          "earliest_at",
          "latest_at",
          "required_state"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "capability_key": {
            "enum": [
              "lighting.set",
              "switch.set",
              "climate.set_mode",
              "climate.set_temperature",
              "cover.set",
              "media.set",
              "fan.set",
              "scene.activate",
              "vacuum.set",
              "humidifier.set",
              "reminder.show",
              "preference.save"
            ]
          },
          "target_entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[a-z_][a-z0-9_]*\\.[a-z0-9_]+$"
            },
            "maxItems": 20,
            "uniqueItems": true
          },
          "desired": {
            "type": "object",
            "maxProperties": 20,
            "propertyNames": {
              "maxLength": 80
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "after_step_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "earliest_at": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "latest_at": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "required_state": {
            "type": "object",
            "maxProperties": 20,
            "propertyNames": {
              "maxLength": 80
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "maxItems": 5,
      "minItems": 1
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "until"
      ],
      "properties": {
        "from": {
          "type": "string",
          "maxLength": 40,
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "maxLength": 40,
          "format": "date-time"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_opportunities",
        "successes",
        "counterexamples",
        "distinct_days"
      ],
      "properties": {
        "eligible_opportunities": {
          "type": "integer",
          "minimum": 0
        },
        "successes": {
          "type": "integer",
          "minimum": 0
        },
        "counterexamples": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "wilson_lower": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "weighted_score": {
      "type": "number",
      "minimum": 0
    },
    "baseline_frequency": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "temporal_validation": {
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "evidence_episode_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "maxItems": 500
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "reviewed_at": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40,
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "type": "string",
      "maxLength": 40,
      "format": "date-time"
    },
    "privacy_scope_version": {
      "type": "integer",
      "minimum": 1
    },
    "status_reason": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "maxItems": 20
    }
  },
  "$id": "urn:home-ai-core:habit-pattern.v1",
  "title": "HabitPattern"
}
