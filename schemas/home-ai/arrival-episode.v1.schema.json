{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "state",
    "scope",
    "subject_id",
    "absent_since",
    "arrived_at",
    "stable_at",
    "window_from",
    "window_until",
    "local_date",
    "weekday",
    "daypart",
    "coverage",
    "others_present",
    "guests",
    "door_evidence",
    "action_operation_ids",
    "automation_effects",
    "late_corrected"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "state": {
      "enum": [
        "arrival_candidate",
        "present_stable",
        "ambiguous",
        "cancelled"
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "subject_id"
          ],
          "properties": {
            "kind": {
              "const": "household"
            },
            "subject_id": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "subject_id"
          ],
          "properties": {
            "kind": {
              "const": "person"
            },
            "subject_id": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "subject_id"
          ],
          "properties": {
            "kind": {
              "const": "anonymous"
            },
            "subject_id": {
              "type": "null"
            }
          }
        }
      ]
    },
    "subject_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "absent_since": {
      "type": "string",
      "maxLength": 40,
      "format": "date-time"
    },
    "arrived_at": {
      "type": "string",
      "maxLength": 40,
      "format": "date-time"
    },
    "stable_at": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40,
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "window_from": {
      "type": "string",
      "maxLength": 40,
      "format": "date-time"
    },
    "window_until": {
      "type": "string",
      "maxLength": 40,
      "format": "date-time"
    },
    "local_date": {
      "type": "string",
      "maxLength": 10,
      "format": "date"
    },
    "weekday": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "daypart": {
      "enum": [
        "night",
        "morning",
        "afternoon",
        "evening"
      ]
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "others_present": {
      "type": "boolean"
    },
    "guests": {
      "type": "boolean"
    },
    "door_evidence": {
      "type": "boolean"
    },
    "action_operation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "maxItems": 50
    },
    "automation_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z_][a-z0-9_]*\\.[a-z0-9_]+$"
      },
      "maxItems": 50
    },
    "late_corrected": {
      "type": "boolean"
    }
  },
  "$id": "urn:home-ai-core:arrival-episode.v1",
  "title": "ArrivalEpisode"
}
